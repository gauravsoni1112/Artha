          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (operation) (rate(artha_langfuse_export_errors_total[5m]))",
          "legendFormat": "{{ operation }}",
          "refId": "A"
        }
      ],
      "title": "LLM Export Errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "id": 13,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "artha_breaker_state",
          "legendFormat": "{{ agent_id }}",
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker State (0=Closed 1=Open 2=Half-Open)",
