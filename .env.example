# ── LLM Configuration ────────────────────────────────────────────────────────
# Provider: anthropic | openai | ollama (default: ollama — no API key needed)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434

# For Anthropic (Claude):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-...

# For OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Deterministic output (recommended for finance queries)
LLM_TEMPERATURE=0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://artha:artha_secret@localhost:5432/artha

# ── File Store ───────────────────────────────────────────────────────────────
# Fernet key for encrypting raw documents. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_STORE_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
