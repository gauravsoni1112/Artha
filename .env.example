# ── LLM Configuration ────────────────────────────────────────────────────────
# Provider: anthropic | openai | ollama (default: ollama — no API key needed)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=sk-ant-api03-...
LLM_TEMPERATURE=0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://artha:artha_secret@localhost:5432/artha

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── File Store ───────────────────────────────────────────────────────────────
# Fernet key for encrypting raw documents. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_STORE_KEY=tRlwcGp_9Xgkykc4hyrpOpmbK1RRC-Oiolpc3IE2mPU=

# ── Gmail Connector ──────────────────────────────────────────────────────────
# OAuth2 credentials. See docs/INGESTION_SETUP.md for setup instructions.
GMAIL_CLIENT_SECRETS=path/to/client_secrets.json
GMAIL_TOKEN_PATH=~/.artha/gmail_token.json

# ── Zerodha Connector ────────────────────────────────────────────────────────
# Kite Connect API credentials. See docs/INGESTION_SETUP.md for setup instructions.
# Note: ZERODHA_ACCESS_TOKEN expires daily and must be refreshed via Kite login.
ZERODHA_API_KEY=your_kite_api_key
ZERODHA_ACCESS_TOKEN=your_kite_access_token
ZERODHA_LOOKBACK_DAYS=90

# ── Agent Configuration ──────────────────────────────────────────────────────
# Phase 3+ multi-step reasoning agent settings
REFLECTION_THRESHOLD=0.7
MAX_REFLECT_ITERATIONS=2
CONTEXT_WINDOW_THRESHOLD=20
CONTEXT_WINDOW_KEEP=6
AGENT_MAX_ITERATIONS=10

# ── Phase 4: Domain Agent Registry ───────────────────────────────────────────
# Set in each agent container's environment (see infra/docker-compose.yml).
# Only needed when running agents outside Docker (e.g. local dev of a single agent).
# AGENT_ID=cashflow_agent
# AGENT_ENDPOINT=http://localhost:8001
# AGENT_CAPABILITIES=cashflow,spending,budget
# REGISTRY_URL=http://localhost:8000
# SKIP_AGENT_REGISTRATION=false   # set true to start agent without registering

# ── Phase 4: Per-agent LLM overrides ─────────────────────────────────────────
# Format: <AGENT_ID_UPPER>_LLM_<FIELD>
# Unset fields fall back to the global LLM_* values above.
# CASHFLOW_AGENT_LLM_PROVIDER=anthropic
# CASHFLOW_AGENT_LLM_MODEL=claude-haiku-4-5-20251001
# CASHFLOW_AGENT_LLM_API_KEY=sk-ant-...
# RISK_AGENT_LLM_TEMPERATURE=0.2
# TAX_AGENT_LLM_PROVIDER=openai
# TAX_AGENT_LLM_MODEL=gpt-4o-mini
